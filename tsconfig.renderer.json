{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "rootDir": "src",
    "outDir": "dist/web",
    "strict": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["src/renderer/**/*", "src/shared/**/*"]
}
